# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
# production enables the strict CORS allowlist (FRONTEND_URL); any other
# value allows all origins (local dev, where ports hop between 3000/3001/…)
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Must include the database name (e.g.
# `?appName=Farmpath` or a path like `/farmpath` before the query string).
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/farmpath?appName=Farmpath

# ── Auth ────────────────────────────────────────────────────────────────
# Use a long random string in production (32+ characters; Render can generate one)
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=30d

# ── Deployment ──────────────────────────────────────────────────────────
# Deployed frontend origin(s), comma-separated. Required in production —
# this is the CORS allowlist.
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:5173
# Public base URL of this API (used to build absolute /uploads URLs in
# disk-storage mode; unused when Cloudinary is configured)
PUBLIC_API_URL=http://localhost:5000

# ── AI service (required in production) ─────────────────────────────────
# FastAPI/XGBoost crop-advisory base URL. Development may leave this unset.
AI_SERVICE_URL=
# Must match FarmPath-AI's AI_SERVICE_API_KEY in production.
AI_SERVICE_API_KEY=

# ── Escrow ──────────────────────────────────────────────────────────────
# Set to 1 to disable the hourly in-process escrow sweeper (server.js only;
# never runs under Vercel's api/index.js, which uses a cron instead)
DISABLE_ESCROW_SWEEP=
# Bearer token for GET /api/orders/escrow/cron (cron-style triggers)
CRON_SECRET=

# ── Legacy placeholders (read only by src/config/services.js, currently
# ── unused by the app — kept for compatibility) ─────────────────────────
WEATHER_API_KEY=
PAYMENT_GATEWAY_KEY=
AI_API_KEY=
CLOUD_STORAGE_BUCKET=
